{
  "name": "mini-ai-ide",
  "version": "0.2.5",
  "private": true,
  "description": "Windows 桌面工具：Monaco 本地编辑、DeepSeek 网页接入、规范工具执行与可控结果回传",
  "author": "Mini-AI-IDE contributors",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs && node tools/check-renderer-scope.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "start": "npm run build && electron .",
    "self-test": "npm run build && electron . --self-test",
    "diagnose": "npm run build && electron . --diagnose",
    "ui-probe": "npm run build && electron . --ui-probe",
    "verify:workspace": "npm run build && electron . --workspace-probe",
    "ui-probe:bubble": "npm run build && electron . --ui-probe --test-bubble",
    "ui-probe:findhover": "npm run build && electron . --ui-probe --test-findhover",
    "verify:range": "npm run build && node tools/verify-range-normalize.mjs && node tools/verify-bubble-selfrules-offline.mjs",
    "verify:prompt": "npm run build && node tools/verify-prompt-panel-offline.mjs",
    "setup:electron": "node scripts/install-electron.mjs",
    "gen-icon": "node tools/gen-icon.mjs",
    "package:win": "node scripts/package-win.mjs",
    "package:win:dir": "node scripts/package-win.mjs --dir",
    "prepare:release": "node scripts/prepare-release.mjs",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.10.2",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "monaco-editor": "0.57.0",
    "patch-package": "8.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "js-yaml": "4.3.2"
  }
}
